{
  "contractId": "CA4HEQTL2WPEUYKYKCDOHCDNIV4QHNJ7EL4J4NQ6VADP7SYHVRYZ7AW2",
  "description": "Soroswap AMM factory: creates and indexes Soroswap pair contracts on Stellar mainnet.",
  "events": [],
  "functions": [
    {
      "doc": "Returns the recipient of the fee.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n\n# Errors\n\nReturns an error if the Factory is not yet initialized.",
      "name": "fee_to",
      "params": [],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "address",
        "type": "result"
      }
    },
    {
      "doc": "Returns the address allowed to change the fee recipient.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n\n# Errors\n\nReturns an error if the Factory is not yet initialized.",
      "name": "fee_to_setter",
      "params": [],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "address",
        "type": "result"
      }
    },
    {
      "doc": "Checks if fees are enabled.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n\n# Errors\n\nReturns an error if the Factory is not yet initialized.",
      "name": "fees_enabled",
      "params": [],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "bool",
        "type": "result"
      }
    },
    {
      "doc": "Returns the total number of pairs created through the factory so far.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n\n# Errors\n\nReturns an error if the Factory is not yet initialized.",
      "name": "all_pairs_length",
      "params": [],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "u32",
        "type": "result"
      }
    },
    {
      "doc": "Returns the address of the pair for `token_a` and `token_b`, if it has been created.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n* `token_a` - The address of the first token in the pair.\n* `token_b` - The address of the second token in the pair.\n\n# Errors\n\nReturns an error if the Factory is not yet initialized or if the pair does not exist",
      "name": "get_pair",
      "params": [
        { "name": "token_a", "type": "address" },
        { "name": "token_b", "type": "address" }
      ],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "address",
        "type": "result"
      }
    },
    {
      "doc": "Returns the address of the nth pair (0-indexed) created through the factory, or address(0) if not enough pairs have been created yet.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n* `n` - The index of the pair to retrieve.\n\n# Errors\n\nReturns an error if the Factory is not yet initialized or if index `n` does not exist.",
      "name": "all_pairs",
      "params": [{ "name": "n", "type": "u32" }],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "address",
        "type": "result"
      }
    },
    {
      "doc": "Checks if a pair exists for the given `token_a` and `token_b`.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n* `token_a` - The address of the first token in the pair.\n* `token_b` - The address of the second token in the pair.\n\n# Errors\n\nReturns an error if the Factory is not yet initialized.",
      "name": "pair_exists",
      "params": [
        { "name": "token_a", "type": "address" },
        { "name": "token_b", "type": "address" }
      ],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "bool",
        "type": "result"
      }
    },
    {
      "doc": "Sets the `fee_to_setter` address and initializes the factory.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n* `setter` - The address to set as the current `fee_to_setter`.\n* `pair_wasm_hash` - The Wasm hash of the pair.\n\n# Errors\n\nReturns an error if the Factory is already initialized.",
      "name": "initialize",
      "params": [
        { "name": "setter", "type": "address" },
        { "name": "pair_wasm_hash", "type": { "size": 32, "type": "bytes_n" } }
      ],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    {
      "doc": "Sets the `fee_to` address.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n* `to` - The address to set as the `fee_to`.\n\n# Errors\n\nReturns an error if the Factory is not yet initialized or if the caller is not the current `fee_to_setter`.",
      "name": "set_fee_to",
      "params": [{ "name": "to", "type": "address" }],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    {
      "doc": "Sets the `fee_to_setter` address.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n* `new_setter` - The address to set as the new `fee_to_setter`.\n\n# Errors\n\nReturns an error if the Factory is not yet initialized or if the caller is not the existing `fee_to_setter`.",
      "name": "set_fee_to_setter",
      "params": [{ "name": "new_setter", "type": "address" }],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    {
      "doc": "Sets whether fees are enabled or disabled.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n* `is_enabled` - A boolean indicating whether fees are enabled or disabled.\n\n# Errors\n\nReturns an error if the Factory is not yet initialized or if the caller is not the current `fee_to_setter`.",
      "name": "set_fees_enabled",
      "params": [{ "name": "is_enabled", "type": "bool" }],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    {
      "doc": "Creates a pair for `token_a` and `token_b` if one doesn't exist already.\n\n# Arguments\n\n* `e` - An instance of the `Env` struct.\n* `token_a` - The address of the first token in the pair.\n* `token_b` - The address of the second token in the pair.\n\n# Errors\n\nReturns an error if the pair is not yet initialized, if `token_a` and `token_b` have identical addresses, or if the pair already exists between `token_a` and `token_b`.",
      "name": "create_pair",
      "params": [
        { "name": "token_a", "type": "address" },
        { "name": "token_b", "type": "address" }
      ],
      "returns": {
        "err": { "name": "FactoryError", "type": "named" },
        "ok": "address",
        "type": "result"
      }
    }
  ],
  "name": "Soroswap Factory",
  "network": "mainnet",
  "types": {
    "DataKey": {
      "cases": [
        { "fields": [], "name": "FeeTo" },
        { "fields": [], "name": "FeeToSetter" },
        { "fields": [], "name": "PairWasmHash" },
        { "fields": [], "name": "FeesEnabled" },
        { "fields": [], "name": "TotalPairs" },
        { "fields": [{ "name": "_0", "type": "u32" }], "name": "PairAddressesNIndexed" },
        {
          "fields": [{ "name": "_0", "type": { "name": "Pair", "type": "named" } }],
          "name": "PairAddressesByTokens"
        }
      ],
      "kind": "union",
      "name": "DataKey"
    },
    "FactoryError": {
      "kind": "enum",
      "name": "FactoryError",
      "variants": [
        {
          "discriminant": 201,
          "doc": "SoroswapFactory: not yet initialized",
          "name": "NotInitialized"
        },
        {
          "discriminant": 202,
          "doc": "SoroswapFactory: token_a and token_b have identical addresses",
          "name": "CreatePairIdenticalTokens"
        },
        {
          "discriminant": 203,
          "doc": "SoroswapFactory: pair already exists between token_a and token_b",
          "name": "CreatePairAlreadyExists"
        },
        {
          "discriminant": 204,
          "doc": "SoroswapFactory: already initialized",
          "name": "InitializeAlreadyInitialized"
        },
        {
          "discriminant": 205,
          "doc": "SoroswapFactory: pair does not exist",
          "name": "PairDoesNotExist"
        },
        {
          "discriminant": 206,
          "doc": "SoroswapFactory: index does not exist",
          "name": "IndexDoesNotExist"
        }
      ]
    },
    "FeeToSettedEvent": {
      "fields": [
        { "name": "new", "type": "address" },
        { "name": "old", "type": "address" },
        { "name": "setter", "type": "address" }
      ],
      "kind": "struct",
      "name": "FeeToSettedEvent"
    },
    "InitializedEvent": {
      "fields": [{ "name": "setter", "type": "address" }],
      "kind": "struct",
      "name": "InitializedEvent"
    },
    "NewFeesEnabledEvent": {
      "fields": [{ "name": "fees_enabled", "type": "bool" }],
      "kind": "struct",
      "name": "NewFeesEnabledEvent"
    },
    "NewPairEvent": {
      "fields": [
        { "name": "new_pairs_length", "type": "u32" },
        { "name": "pair", "type": "address" },
        { "name": "token_0", "type": "address" },
        { "name": "token_1", "type": "address" }
      ],
      "kind": "struct",
      "name": "NewPairEvent"
    },
    "NewSetterEvent": {
      "fields": [
        { "name": "new", "type": "address" },
        { "name": "old", "type": "address" }
      ],
      "kind": "struct",
      "name": "NewSetterEvent"
    },
    "Pair": {
      "fields": [
        { "name": "0", "type": "address" },
        { "name": "1", "type": "address" }
      ],
      "kind": "struct",
      "name": "Pair"
    },
    "PairError": {
      "kind": "enum",
      "name": "PairError",
      "variants": [
        {
          "discriminant": 901,
          "doc": "SoroswapFactory: token_a and token_b have identical addresses",
          "name": "CreatePairIdenticalTokens"
        }
      ]
    }
  },
