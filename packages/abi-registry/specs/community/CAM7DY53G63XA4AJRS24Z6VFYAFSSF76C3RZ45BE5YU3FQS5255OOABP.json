{
  "contractId": "CAM7DY53G63XA4AJRS24Z6VFYAFSSF76C3RZ45BE5YU3FQS5255OOABP",
  "description": "Soroswap AMM pair for XLM/USDC on Stellar mainnet; every Soroswap pair shares this WASM.",
  "events": [],
  "functions": [
    { "name": "total_supply", "params": [], "returns": "i128" },
    {
      "name": "allowance",
      "params": [
        { "name": "from", "type": "address" },
        { "name": "spender", "type": "address" }
      ],
      "returns": "i128"
    },
    {
      "name": "approve",
      "params": [
        { "name": "from", "type": "address" },
        { "name": "spender", "type": "address" },
        { "name": "amount", "type": "i128" },
        { "name": "expiration_ledger", "type": "u32" }
      ],
      "returns": "void"
    },
    { "name": "balance", "params": [{ "name": "id", "type": "address" }], "returns": "i128" },
    {
      "name": "transfer",
      "params": [
        { "name": "from", "type": "address" },
        { "name": "to", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "returns": "void"
    },
    {
      "name": "transfer_from",
      "params": [
        { "name": "spender", "type": "address" },
        { "name": "from", "type": "address" },
        { "name": "to", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "returns": "void"
    },
    {
      "name": "burn",
      "params": [
        { "name": "from", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "returns": "void"
    },
    {
      "name": "burn_from",
      "params": [
        { "name": "spender", "type": "address" },
        { "name": "from", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "returns": "void"
    },
    { "name": "decimals", "params": [], "returns": "u32" },
    { "name": "name", "params": [], "returns": "string" },
    { "name": "symbol", "params": [], "returns": "string" },
    {
      "doc": "Initializes a new Soroswap pair by setting token addresses, factory, and initial reserves.\n\n# Arguments\n* `e` - The runtime environment.\n* `factory` - The address of the Soroswap factory contract.\n* `token_0` - The address of the first token in the pair.\n* `token_1` - The address of the second token in the pair.",
      "name": "initialize",
      "params": [
        { "name": "factory", "type": "address" },
        { "name": "token_0", "type": "address" },
        { "name": "token_1", "type": "address" }
      ],
      "returns": {
        "err": { "name": "SoroswapPairError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    {
      "doc": "Returns the address of the first token in the Soroswap pair.",
      "name": "token_0",
      "params": [],
      "returns": "address"
    },
    {
      "doc": "Returns the address of the second token in the Soroswap pair.",
      "name": "token_1",
      "params": [],
      "returns": "address"
    },
    {
      "doc": "Returns the address of the Soroswap factory contract.",
      "name": "factory",
      "params": [],
      "returns": "address"
    },
    {
      "doc": "Deposits tokens into the Soroswap pair and mints LP tokens in return.\n\n# Arguments\n* `e` - The runtime environment.\n* `to` - The address where the minted LP tokens will be sent.\n\n# Returns\nThe amount of minted LP tokens.\nPossible errors:\n- `SoroswapPairError::NotInitialized`: The Soroswap pair has not been initialized.\n- `SoroswapPairError::DepositInsufficientAmountToken0`: Insufficient amount of token 0 sent.\n- `SoroswapPairError::DepositInsufficientAmountToken1`: Insufficient amount of token 1 sent.\n- `SoroswapPairError::DepositInsufficientFirstLiquidity`: Insufficient first liquidity minted.\n- `SoroswapPairError::DepositInsufficientLiquidityMinted`: Insufficient liquidity minted.\n- `SoroswapPairError::UpdateOverflow`: Overflow occurred during update.",
      "name": "deposit",
      "params": [{ "name": "to", "type": "address" }],
      "returns": {
        "err": { "name": "SoroswapPairError", "type": "named" },
        "ok": "i128",
        "type": "result"
      }
    },
    {
      "doc": "Executes a token swap within the Soroswap pair.\n\n# Arguments\n* `e` - The runtime environment.\n* `amount_0_out` - The desired amount of the first token to receive.\n* `amount_1_out` - The desired amount of the second token to receive.\n* `to` - The address where the swapped tokens will be sent.\nReturns an error if the swap cannot be executed. Possible errors include:\n- `SoroswapPairError::NotInitialized`\n- `SoroswapPairError::SwapInsufficientOutputAmount`\n- `SoroswapPairError::SwapNegativesOutNotSupported`\n- `SoroswapPairError::SwapInsufficientLiquidity`\n- `SoroswapPairError::SwapInvalidTo`\n- `SoroswapPairError::SwapInsufficientInputAmount`\n- `SoroswapPairError::SwapNegativesInNotSupported`\n- `SoroswapPairError::SwapKConstantNotMet`: If the K constant condition is not met after the swap.",
      "name": "swap",
      "params": [
        { "name": "amount_0_out", "type": "i128" },
        { "name": "amount_1_out", "type": "i128" },
        { "name": "to", "type": "address" }
      ],
      "returns": {
        "err": { "name": "SoroswapPairError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    {
      "doc": "Withdraws liquidity from the Soroswap pair, burning LP tokens and returning the corresponding tokens to the user.\n\n# Arguments\n* `e` - The runtime environment.\n* `to` - The address where the withdrawn tokens will be sent.\n\n# Returns\nA tuple containing the amounts of token 0 and token 1 withdrawn from the pair.",
      "name": "withdraw",
      "params": [{ "name": "to", "type": "address" }],
      "returns": {
        "err": { "name": "SoroswapPairError", "type": "named" },
        "ok": { "elements": ["i128", "i128"], "type": "tuple" },
        "type": "result"
      }
    },
    {
      "doc": "Skims excess tokens from reserves and sends them to the specified address.\n\n# Arguments\n* `e` - The runtime environment.\n* `to` - The address where the excess tokens will be sent.",
      "name": "skim",
      "params": [{ "name": "to", "type": "address" }],
      "returns": "void"
    },
    {
      "doc": "Forces reserves to match current balances.\n\n# Arguments\n* `e` - The runtime environment.",
      "name": "sync",
      "params": [],
      "returns": "void"
    },
    {
      "doc": "Returns the current reserves and the last block timestamp.\n\n# Arguments\n* `e` - The runtime environment.\n\n# Returns\nA tuple containing the reserves of token 0 and token 1.",
      "name": "get_reserves",
      "params": [],
      "returns": { "elements": ["i128", "i128"], "type": "tuple" }
    },
    {
      "doc": "Returns the value of the last product of reserves (`K`) stored in the contract.\n\n# Arguments\n* `e` - The runtime environment.\n\n# Returns\nThe value of the last product of reserves (`K`).",
      "name": "k_last",
      "params": [],
      "returns": "i128"
    }
  ],
  "name": "Soroswap Pair (XLM/USDC)",
  "network": "mainnet",
  "types": {
    "AllowanceDataKey": {
      "fields": [
        { "name": "from", "type": "address" },
        { "name": "spender", "type": "address" }
      ],
      "kind": "struct",
      "name": "AllowanceDataKey"
    },
    "AllowanceValue": {
      "fields": [
        { "name": "amount", "type": "i128" },
        { "name": "expiration_ledger", "type": "u32" }
      ],
      "kind": "struct",
      "name": "AllowanceValue"
    },
    "DataKey": {
      "cases": [
        {
          "fields": [{ "name": "_0", "type": { "name": "AllowanceDataKey", "type": "named" } }],
          "name": "Allowance"
        },
        { "fields": [{ "name": "_0", "type": "address" }], "name": "Balance" },
        { "fields": [], "name": "TotalSupply" }
      ],
      "kind": "union",
      "name": "DataKey"
    },
    "DepositEvent": {
      "fields": [
        { "name": "amount_0", "type": "i128" },
        { "name": "amount_1", "type": "i128" },
        { "name": "liquidity", "type": "i128" },
        { "name": "new_reserve_0", "type": "i128" },
        { "name": "new_reserve_1", "type": "i128" },
        { "name": "to", "type": "address" }
      ],
      "kind": "struct",
      "name": "DepositEvent"
    },
    "FactoryError": {
      "kind": "enum",
      "name": "FactoryError",
      "variants": [
        {
          "discriminant": 201,
          "doc": "SoroswapFactory: not yet initialized",
          "name": "NotInitialized"
        },
        {
          "discriminant": 202,
          "doc": "SoroswapFactory: token_a and token_b have identical addresses",
          "name": "CreatePairIdenticalTokens"
        },
        {
          "discriminant": 203,
          "doc": "SoroswapFactory: pair already exists between token_a and token_b",
          "name": "CreatePairAlreadyExists"
        },
        {
          "discriminant": 204,
          "doc": "SoroswapFactory: already initialized",
          "name": "InitializeAlreadyInitialized"
        },
        {
          "discriminant": 205,
          "doc": "SoroswapFactory: pair does not exist",
          "name": "PairDoesNotExist"
        },
        {
          "discriminant": 206,
          "doc": "SoroswapFactory: index does not exist",
          "name": "IndexDoesNotExist"
        }
      ]
    },
    "SkimEvent": {
      "fields": [
        { "name": "skimmed_0", "type": "i128" },
        { "name": "skimmed_1", "type": "i128" }
      ],
      "kind": "struct",
      "name": "SkimEvent"
    },
    "SoroswapPairError": {
      "kind": "enum",
      "name": "SoroswapPairError",
      "variants": [
        {
          "discriminant": 101,
          "doc": "SoroswapPair: already initialized",
          "name": "InitializeAlreadyInitialized"
        },
        {
          "discriminant": 102,
          "doc": "SoroswapPair: not yet initialized",
          "name": "NotInitialized"
        },
        {
          "discriminant": 103,
          "doc": "SoroswapPair: token_0 must be less than token_1 while initializing",
          "name": "InitializeTokenOrderInvalid"
        },
        {
          "discriminant": 104,
          "doc": "SoroswapPair: insufficient amount of token 0 sent while doing deposit",
          "name": "DepositInsufficientAmountToken0"
        },
        {
          "discriminant": 105,
          "doc": "SoroswapPair: insufficient amount of token 1 sent while doing deposit",
          "name": "DepositInsufficientAmountToken1"
        },
        {
          "discriminant": 106,
          "doc": "SoroswapPair: insufficient first liquidity minted while doing deposit",
          "name": "DepositInsufficientFirstLiquidity"
        },
        {
          "discriminant": 107,
          "doc": "SoroswapPair: insufficient liquidity minted while doing deposit",
          "name": "DepositInsufficientLiquidityMinted"
        },
        {
          "discriminant": 108,
          "doc": "SoroswapPair: insufficient output amount while doing deposDepositit",
          "name": "SwapInsufficientOutputAmount"
        },
        {
          "discriminant": 109,
          "doc": "SoroswapPair: negatives amounts out dont supported while doing swap",
          "name": "SwapNegativesOutNotSupported"
        },
        {
          "discriminant": 110,
          "doc": "SoroswapPair: insufficient liquidity to do the swap",
          "name": "SwapInsufficientLiquidity"
        },
        {
          "discriminant": 111,
          "doc": "SoroswapPair: invalid to to do the swap",
          "name": "SwapInvalidTo"
        },
        {
          "discriminant": 112,
          "doc": "SoroswapPair: insufficient input amount while doing swap",
          "name": "SwapInsufficientInputAmount"
        },
        {
          "discriminant": 113,
          "doc": "SoroswapPair: negatives amounts in dont supported while doing swap",
          "name": "SwapNegativesInNotSupported"
        },
        {
          "discriminant": 114,
          "doc": "SoroswapPair: K constant is not met while doing swap",
          "name": "SwapKConstantNotMet"
        },
        {
          "discriminant": 115,
          "doc": "SoroswapPair: liquidity was not initialized yet while doing withdraw",
          "name": "WithdrawLiquidityNotInitialized"
        },
        {
          "discriminant": 116,
          "doc": "SoroswapPair: insufficient sent shares while doing withdraw",
          "name": "WithdrawInsufficientSentShares"
        },
        {
          "discriminant": 117,
          "doc": "SoroswapPair: insufficient liquidity burned while doing withdraw",
          "name": "WithdrawInsufficientLiquidityBurned"
        },
        {
          "discriminant": 118,
          "doc": "SoroswapPair: OVERFLOW while updating",
          "name": "UpdateOverflow"
        }
      ]
    },
    "SwapEvent": {
      "fields": [
        { "name": "amount_0_in", "type": "i128" },
        { "name": "amount_0_out", "type": "i128" },
        { "name": "amount_1_in", "type": "i128" },
        { "name": "amount_1_out", "type": "i128" },
        { "name": "to", "type": "address" }
      ],
      "kind": "struct",
      "name": "SwapEvent"
    },
    "SyncEvent": {
      "fields": [
        { "name": "new_reserve_0", "type": "i128" },
        { "name": "new_reserve_1", "type": "i128" }
      ],
      "kind": "struct",
      "name": "SyncEvent"
    },
    "TokenMetadata": {
      "fields": [
        { "name": "decimal", "type": "u32" },
        { "name": "name", "type": "string" },
        { "name": "symbol", "type": "string" }
      ],
      "kind": "struct",
      "name": "TokenMetadata"
    },
    "WithdrawEvent": {
      "fields": [
        { "name": "amount_0", "type": "i128" },
        { "name": "amount_1", "type": "i128" },
        { "name": "liquidity", "type": "i128" },
        { "name": "new_reserve_0", "type": "i128" },
        { "name": "new_reserve_1", "type": "i128" },
        { "name": "to", "type": "address" }
      ],
      "kind": "struct",
      "name": "WithdrawEvent"
    }
  },
