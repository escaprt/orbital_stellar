{
  "contractId": "CDSYOAVXFY7SM5S64IZPPPYB4GVGGLMQVFREPSQQEZVIWXX5R23G4QSU",
  "description": "Blend v2 pool factory: deploys new Blend lending pools on Stellar mainnet.",
  "events": [],
  "functions": [
    {
      "doc": "Construct the pool factory contract\n\n### Arguments\n* `pool_init_meta` - The pool initialization metadata",
      "name": "__constructor",
      "params": [{ "name": "pool_init_meta", "type": { "name": "PoolInitMeta", "type": "named" } }],
      "returns": "void"
    },
    {
      "name": "deploy",
      "params": [
        { "name": "admin", "type": "address" },
        { "name": "name", "type": "string" },
        { "name": "salt", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "oracle", "type": "address" },
        { "name": "backstop_take_rate", "type": "u32" },
        { "name": "max_positions", "type": "u32" },
        { "name": "min_collateral", "type": "i128" }
      ],
      "returns": "address"
    },
    {
      "name": "is_pool",
      "params": [{ "name": "pool_address", "type": "address" }],
      "returns": "bool"
    }
  ],
  "name": "Blend Pool Factory",
  "network": "mainnet",
  "types": {
    "PoolFactoryDataKey": {
      "cases": [{ "fields": [{ "name": "_0", "type": "address" }], "name": "Contracts" }],
      "kind": "union",
      "name": "PoolFactoryDataKey"
    },
    "PoolFactoryError": {
      "doc": "Error codes for the pool factory contract. Common errors are codes that match up with the built-in\ncontracts error reporting. Pool factory specific errors start at 1300.",
      "kind": "enum",
      "name": "PoolFactoryError",
      "variants": [
        { "discriminant": 1, "name": "InternalError" },
        { "discriminant": 3, "name": "AlreadyInitializedError" },
        { "discriminant": 1300, "name": "InvalidPoolInitArgs" }
      ]
    },
    "PoolInitMeta": {
      "fields": [
        { "name": "backstop", "type": "address" },
        { "name": "blnd_id", "type": "address" },
        { "name": "pool_hash", "type": { "size": 32, "type": "bytes_n" } }
      ],
      "kind": "struct",
      "name": "PoolInitMeta"
    }
  },
