          "type": "i128"
        },
        {
          "name": "amount_in_max",
          "type": "i128"
        },
        {
          "name": "distribution",
          "type": {
            "item": {
              "name": "DexDistribution",
              "type": "named"
            },
            "type": "vec"
          }
        },
        {
          "name": "to",
          "type": "address"
        },
