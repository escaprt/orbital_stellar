{
  "contractId": "CCOQM6S7ICIUWA225O5PSJWUBEMXGFSSW2PQFO6FP4DQEKMS5DASRGRR",
  "description": "Blend emitter contract: the BLND emission source distributing rewards to backstop depositors on Stellar mainnet.",
  "events": [],
  "functions": [
    {
      "name": "initialize",
      "params": [
        { "name": "blnd_token", "type": "address" },
        { "name": "backstop", "type": "address" },
        { "name": "backstop_token", "type": "address" }
      ],
      "returns": "void"
    },
    { "name": "distribute", "params": [], "returns": "i128" },
    {
      "name": "get_last_distro",
      "params": [{ "name": "backstop_id", "type": "address" }],
      "returns": "u64"
    },
    { "name": "get_backstop", "params": [], "returns": "address" },
    {
      "name": "queue_swap_backstop",
      "params": [
        { "name": "new_backstop", "type": "address" },
        { "name": "new_backstop_token", "type": "address" }
      ],
      "returns": "void"
    },
    {
      "name": "get_queued_swap",
      "params": [],
      "returns": { "inner": { "name": "Swap", "type": "named" }, "type": "option" }
    },
    { "name": "cancel_swap_backstop", "params": [], "returns": "void" },
    { "name": "swap_backstop", "params": [], "returns": "void" },
    {
      "name": "drop",
      "params": [
        {
          "name": "list",
          "type": { "item": { "elements": ["address", "i128"], "type": "tuple" }, "type": "vec" }
        }
      ],
      "returns": "void"
    }
  ],
  "name": "Blend Emitter",
  "network": "mainnet",
  "types": {
    "EmitterDataKey": {
      "cases": [
        { "fields": [{ "name": "_0", "type": "address" }], "name": "LastDistro" },
        { "fields": [{ "name": "_0", "type": "address" }], "name": "Dropped" }
      ],
      "kind": "union",
      "name": "EmitterDataKey"
    },
    "EmitterError": {
      "doc": "Error codes for the emitter contract. Common errors are codes that match up with the built-in\ncontracts error reporting. Emitter specific errors start at 1100.",
      "kind": "enum",
      "name": "EmitterError",
      "variants": [
        { "discriminant": 1, "name": "InternalError" },
        { "discriminant": 3, "name": "AlreadyInitializedError" },
        { "discriminant": 4, "name": "UnauthorizedError" },
        { "discriminant": 1100, "name": "InsufficientBackstopSize" },
        { "discriminant": 1101, "name": "BadDrop" },
        { "discriminant": 1102, "name": "SwapNotQueued" },
        { "discriminant": 1103, "name": "SwapAlreadyExists" },
        { "discriminant": 1104, "name": "SwapNotUnlocked" },
        { "discriminant": 1105, "name": "SwapCannotBeCanceled" }
      ]
    },
    "Swap": {
      "fields": [
        { "name": "new_backstop", "type": "address" },
        { "name": "new_backstop_token", "type": "address" },
        { "name": "unlock_time", "type": "u64" }
      ],
      "kind": "struct",
      "name": "Swap"
    }
  },
